# Copy to .env.local and fill in from your Supabase project's
# Settings -> API page (https://supabase.com/dashboard/project/_/settings/api).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The inventory app's deployed URL and a write-scoped API key minted from
# its /admin/api-keys page. See E:\InventorySystem\API.md for what this
# calls (GET /api/v1/items, POST /api/v1/sales).
INVENTORY_API_URL=
INVENTORY_API_KEY=
